.detail-page {
  padding: 24rpx 24rpx 220rpx;
}

.product-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 430rpx;
  overflow: hidden;
  border-radius: var(--radius);
}

.hero-emoji {
  font-size: 160rpx;
  line-height: 1;
}

.hero-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 600;
}

.hero-category {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #6C5A4A;
  font-size: 21rpx;
}

.overview-card {
  margin-top: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.product-name {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.product-tag {
  flex: none;
  margin-top: 6rpx;
  margin-left: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 20rpx;
}

.product-desc {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}

.merchant-strip {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FAF8F5;
}

.merchant-mark {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  border-radius: 14rpx;
  color: #5D4939;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.merchant-info {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.merchant-name-row {
  display: flex;
  align-items: center;
}

.merchant-name {
  font-size: 24rpx;
  font-weight: 600;
}

.merchant-specialty {
  flex: none;
  margin-left: 8rpx;
  padding: 1rpx 8rpx;
  border-radius: 4rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 17rpx;
}

.merchant-address {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-text-light);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
}

.price-caption {
  padding-bottom: 6rpx;
  color: var(--color-text-light);
  font-size: 22rpx;
}

.card {
  margin-top: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
}

.card-hint {
  color: var(--color-text-light);
  font-size: 22rpx;
}

.spec-list {
  display: flex;
  flex-wrap: wrap;
}

.spec-item {
  display: flex;
  min-width: 180rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 22rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: #FAF8F5;
  flex-direction: column;
}

.spec-item.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.spec-name {
  color: var(--color-text);
  font-size: 25rpx;
  line-height: 1.4;
}

.spec-price {
  margin-top: 2rpx;
  color: var(--color-text-light);
  font-size: 21rpx;
}

.spec-item.is-active .spec-name,
.spec-item.is-active .spec-price {
  color: var(--color-primary);
  font-weight: 600;
}

.next-step {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #F5E2D7;
  border-radius: var(--radius);
  background: #FFF8F3;
}

.next-step-index {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.next-step-copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.next-step-title {
  display: block;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 600;
}

.next-step-desc {
  display: block;
  margin-top: 3rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.55;
}

.order-note {
  margin-top: 24rpx;
  padding: 0 4rpx;
}

.order-note-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.order-note-line {
  display: block;
  color: var(--color-text-light);
  font-size: 21rpx;
  line-height: 1.8;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
  background: var(--color-card);
  box-shadow: 0 -6rpx 24rpx rgba(77, 48, 30, 0.06);
}

.action-price {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.action-label {
  margin-bottom: 2rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.2;
}

.action-price-value {
  font-size: 40rpx;
}

.book-button {
  width: 300rpx;
  flex: none;
  margin-left: 24rpx;
}
