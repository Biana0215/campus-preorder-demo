.order-page {
  padding: 24rpx 24rpx 220rpx;
}

.page-head {
  padding: 8rpx 4rpx 24rpx;
}

.page-kicker {
  display: block;
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.page-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.card {
  margin-bottom: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.summary-main {
  display: flex;
  align-items: flex-start;
}

.summary-thumb {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 12rpx;
  font-size: 54rpx;
  line-height: 112rpx;
  text-align: center;
}

.summary-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.summary-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.summary-spec {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.summary-status {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 19rpx;
}

.summary-price {
  flex: none;
  margin-left: 12rpx;
  padding-top: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: var(--color-line);
}

.store-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-name {
  font-size: 24rpx;
  font-weight: 600;
}

.store-hours {
  color: var(--color-text-light);
  font-size: 21rpx;
}

.store-address {
  display: block;
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
}

.card-hint {
  color: var(--color-text-light);
  font-size: 22rpx;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.slot-item {
  display: flex;
  align-items: center;
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: #FAF8F5;
}

.slot-item.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.slot-item radio {
  flex: none;
  margin-right: 6rpx;
}

.slot-label {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

.slot-item.is-active .slot-label {
  color: var(--color-primary);
  font-weight: 600;
}

.slot-hint {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-light);
  font-size: 21rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.field-last {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.field-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
}

.required-mark {
  margin-left: 4rpx;
  color: var(--color-primary);
  font-size: 26rpx;
}

.field-optional {
  margin-left: 8rpx;
  color: var(--color-text-light);
  font-size: 21rpx;
}

.text-input {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #FAF8F5;
  color: var(--color-text);
  font-size: 26rpx;
}

.input-placeholder {
  color: #B8AEA5;
}

.note-input {
  width: 100%;
  height: 150rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #FAF8F5;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-light);
  font-size: 20rpx;
  text-align: right;
}

.total-card {
  margin-bottom: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  font-size: 24rpx;
}

.total-label {
  color: var(--color-text-secondary);
}

.total-value {
  color: var(--color-text);
}

.total-divider {
  height: 1rpx;
  margin: 18rpx 0;
  background: var(--color-line);
}

.total-row-final {
  align-items: flex-end;
  margin-bottom: 0;
}

.total-final-label {
  font-size: 26rpx;
  font-weight: 600;
}

.total-price {
  font-size: 44rpx;
}

.agreement {
  padding: 8rpx 4rpx 24rpx;
  color: var(--color-text-light);
  font-size: 20rpx;
  line-height: 1.6;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
  background: var(--color-card);
  box-shadow: 0 -6rpx 24rpx rgba(77, 48, 30, 0.06);
}

.action-price {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.action-label {
  margin-bottom: 2rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.2;
}

.action-price-value {
  font-size: 40rpx;
}

.submit-button {
  width: 300rpx;
  flex: none;
  margin-left: 24rpx;
}
