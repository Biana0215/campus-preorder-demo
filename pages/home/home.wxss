.home-page {
  padding: 24rpx 24rpx 48rpx;
}

/* 骨架屏 */
.sk-hero {
  height: 300rpx;
  border-radius: var(--radius);
}

.sk-section {
  margin-top: 36rpx;
}

.sk-title-line {
  width: 240rpx;
  height: 36rpx;
  margin-bottom: 20rpx;
}

.sk-store {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 22rpx;
  border-radius: var(--radius);
  background: var(--color-card);
}

.sk-avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 20rpx;
}

.sk-store-copy {
  flex: 1;
  margin-left: 18rpx;
}

.sk-line-lg {
  width: 62%;
  height: 26rpx;
  margin-bottom: 12rpx;
}

.sk-line-sm {
  width: 88%;
  height: 20rpx;
}

.sk-grid-card {
  height: 190rpx;
}

/* 品牌头卡 */
.hero-card {
  padding: 32rpx;
  border-radius: var(--radius);
  background: linear-gradient(140deg, #E8552D 0%, #CF4622 100%);
  box-shadow: 0 10rpx 30rpx rgba(232, 85, 45, 0.18);
  color: #FFFFFF;
}

.hero-kicker {
  display: block;
  color: rgba(255, 255, 255, 0.66);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-subtitle {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
}

.hero-facts {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-fact {
  display: flex;
  align-items: center;
  flex: 1;
  flex-direction: column;
}

.hero-fact-value {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-fact-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 18rpx;
}

.hero-fact-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-notice {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  line-height: 1.6;
}

/* 我的订单入口 */
.orders-entry {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #F1E6DD;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.orders-entry-icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 18rpx;
  background: var(--color-primary-soft);
  font-size: 30rpx;
  line-height: 64rpx;
  text-align: center;
}

.orders-entry-copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.orders-entry-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.orders-entry-sub {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.orders-entry-right {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 10rpx;
}

.orders-entry-count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-align: center;
}

.orders-entry-arrow {
  margin-left: 8rpx;
  color: #C5BAB1;
  font-size: 30rpx;
  line-height: 1;
}

/* 分区 */
.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-light);
  font-size: 22rpx;
}

.section-link {
  display: flex;
  align-items: center;
  padding-bottom: 4rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.link-arrow {
  margin-left: 4rpx;
  font-size: 30rpx;
  line-height: 1;
}

/* 门店 */
.store-list {
  display: flex;
  flex-direction: column;
}

.store-card {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 22rpx;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.store-mark {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 20rpx;
  color: #5D4939;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.store-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.store-name-row {
  display: flex;
  align-items: center;
}

.store-name {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
}

.store-specialty {
  flex: none;
  margin-left: 10rpx;
  padding: 2rpx 9rpx;
  border-radius: 4rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 18rpx;
}

.store-tagline {
  display: block;
  margin-top: 3rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.store-meta {
  display: flex;
  align-items: center;
  margin-top: 5rpx;
  color: var(--color-text-light);
  font-size: 19rpx;
  line-height: 1.5;
}

.meta-dot {
  margin: 0 8rpx;
}

.store-address {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-text-light);
  font-size: 19rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-enter {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
}

.store-arrow {
  margin-left: 2rpx;
  font-size: 24rpx;
  line-height: 1;
}

/* 分类 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.category-card {
  display: flex;
  align-items: center;
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  line-height: 64rpx;
  text-align: center;
}

.category-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
}

.category-count {
  margin-top: 2rpx;
  color: var(--color-text-light);
  font-size: 21rpx;
}

.category-arrow {
  margin-left: 4rpx;
  color: #C5BAB1;
  font-size: 30rpx;
  line-height: 1;
}

/* 推荐 */
.recommend-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.recommend-card {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--color-card);
  box-shadow: 0 4rpx 18rpx rgba(69, 46, 29, 0.04);
}

.recommend-thumb {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 230rpx;
}

.recommend-emoji {
  font-size: 88rpx;
  line-height: 1;
}

.presale-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
}

.recommend-store-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  max-width: 160rpx;
  overflow: hidden;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6C5A4A;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-body {
  padding: 18rpx 18rpx 20rpx;
}

.recommend-name {
  display: block;
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-tag {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--color-text-light);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.recommend-bottom .price-value {
  font-size: 32rpx;
}

.recommend-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.pickup-tip {
  display: flex;
  margin-top: 36rpx;
  padding: 26rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  background: #FFFDF9;
}

.tip-icon {
  width: 54rpx;
  height: 54rpx;
  flex: none;
  border-radius: 16rpx;
  background: var(--color-primary-soft);
  font-size: 26rpx;
  line-height: 54rpx;
  text-align: center;
}

.tip-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
}

.tip-desc {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

/* 空态 */
.home-empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 24rpx;
  padding: 80rpx 28rpx;
  border-radius: var(--radius);
  background: var(--color-card);
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 6rpx;
  color: var(--color-text-light);
  font-size: 22rpx;
  line-height: 1.6;
}

.empty-retry {
  height: 64rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 64rpx;
}
